{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "RodriAngularTemplateNgNew",
  "title": "Rodri Angular Template application options",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the application.",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use for the application?"
    },
    "directory": {
      "type": "string",
      "description": "Directory in which to create the workspace."
    },
    "skipGit": {
      "type": "boolean",
      "description": "Do not initialize a Git repository.",
      "default": false
    },
    "skipInstall": {
      "type": "boolean",
      "description": "Do not install dependency packages.",
      "default": false
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
