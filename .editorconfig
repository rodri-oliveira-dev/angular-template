# EditorConfig owns editor-level whitespace and file encoding.
# Language formatting stays with Prettier/ESLint to avoid conflicting rules.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown may use two trailing spaces for an intentional hard line break.
[*.md]
trim_trailing_whitespace = false
max_line_length = off
